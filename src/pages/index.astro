---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import Image from '~/components/common/Image.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import CategoryCard from '~/components/joel/CategoryCard.astro';
import ContactSection from '~/components/joel/ContactSection.astro';
import ReviewsMarquee from '~/components/joel/ReviewsMarquee.astro';
import { OPINIONES, RECOMIENDAN } from '~/data/opiniones';
import { CATALOGO, foto } from '~/data/catalogo';
import { NEGOCIO, waLink } from '~/data/negocio';
import { SITE, I18N } from 'astrowind:config';
import buhoClaro from '~/assets/images/marca/buho-claro.png';
import joelRetrato from '../../Imagenes/marca/JOEL-GODOY-retrato.jpg';

const metadata = {
  title: 'Fotografía Joel Godoy — Fotógrafo de bodas y XV años en Los Mochis',
  ignoreTitleTemplate: true,
};

// En móvil: carrusel horizontal deslizable. En escritorio: cuadrícula de 3.
const CARRUSEL =
  '-mx-4 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-2 [scrollbar-width:none] md:mx-0 md:grid md:grid-cols-3 md:gap-5 md:overflow-visible md:px-0 md:pb-0';
const SLIDE = 'w-[80%] flex-none snap-center md:w-auto';

const bodas = CATALOGO.filter((c) => c.grupo === 'Bodas');
const eventos = CATALOGO.filter((c) => c.grupo !== 'Bodas');

// Portada: boda en la playa bajo la Vía Láctea (lo eterno de una boda).
const HERO = foto('B-PLA-03');
const RETRATO = foto('B-MOM-03');

// Mosaico de momentos: selección de Imagenes/bodas/momentos y otras.
const MOMENTOS = ['B-MOM-06', 'B-MOM-01', 'B-MOM-05', 'B-PLA-01', 'B-MOM-10', 'B-MOM-04', 'B-SAL-04', 'B-MOM-09', 'B-MOM-08'].map(
  foto
);

const PROCESO = [
  {
    n: '01',
    t: 'Platiquemos',
    d: 'Nos cuentas tu idea, fecha y lugar. Te enviamos paquetes y apartamos tu fecha con anticipo.',
  },
  {
    n: '02',
    t: 'Planeamos juntos',
    d: 'Revisamos el itinerario, locaciones y la lista de fotos imprescindibles con tu familia.',
  },
  {
    n: '03',
    t: 'El gran día',
    d: 'Llegamos temprano, dirigimos lo justo y documentamos todo lo demás de forma natural.',
  },
  {
    n: '04',
    t: 'Entrega',
    d: 'Recibes un adelanto en días y tu galería completa editada en una galería privada en línea.',
  },
];


const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    '@id': organizationId,
    name: NEGOCIO.nombre,
    url: SITE?.site,
    email: NEGOCIO.email,
    areaServed: 'Sinaloa, México',
    address: { '@type': 'PostalAddress', addressLocality: 'Los Mochis', addressRegion: 'Sinaloa', addressCountry: 'MX' },
    sameAs: [NEGOCIO.facebook, NEGOCIO.instagram].filter(Boolean),
  },
];
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <!-- Portada ****************************** -->
  <!--
    Móvil: la foto ocupa casi toda la pantalla con el título arriba (cielo) y deja
    libres a los novios y la Vía Láctea; el resto del texto va debajo, sobre negro.
    Escritorio: foto de fondo completa con el texto a la derecha (los novios quedan a la izquierda).
  -->
  <section
    data-ref="2"
    data-ref-name="Portada"
    class="relative isolate overflow-hidden bg-black text-white lg:flex lg:min-h-[calc(100svh-72px)] lg:items-center"
  >
    <div
      data-ref="2.1"
      data-ref-name="Foto de portada"
      class="relative h-[72svh] min-h-[440px] lg:absolute lg:inset-0 lg:-z-10 lg:h-auto"
    >
      <Image
        src={HERO.src}
        alt={HERO.alt}
        width={1920}
        height={1280}
        widths={[640, 1080, 1440, 1920, 2400]}
        sizes="100vw"
        layout="cover"
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 h-full w-full object-cover object-[34%_center] lg:object-center"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/0 via-45% to-black lg:hidden"></div>
      <div class="absolute inset-0 hidden bg-gradient-to-l from-black/80 via-black/35 to-black/0 lg:block"></div>

      <!-- Título sobre el cielo (solo móvil) -->
      <div class="absolute inset-x-0 top-0 px-5 pt-7 sm:px-6 lg:hidden">
        <div class="flex items-center gap-3" data-ref="2.2" data-ref-name="Búho y lugar">
          <Image
            src={buhoClaro}
            alt="Búho, sello de Fotografía Joel Godoy"
            width={96}
            widths={[96, 192]}
            sizes="56px"
            loading="eager"
            class="h-auto w-12 opacity-95"
          />
          <p class="text-[0.62rem] font-semibold uppercase leading-relaxed tracking-[0.3em] text-white/85">
            Fotografía de bodas<br />Los Mochis, Sinaloa
          </p>
        </div>
        <p
          data-ref="2.3"
          data-ref-name="Título"
          class="mt-5 font-heading text-[2.6rem] leading-[0.98] [text-shadow:0_2px_18px_rgb(0_0_0/0.6)]"
          aria-hidden="true"
        >
          Historias que se quedan <em class="text-[#d9b48c]">para siempre</em>.
        </p>
      </div>
    </div>

    <!-- Búho: sello de la casa (marca de agua tenue en el cielo, escritorio) -->
    <Image
      src={buhoClaro}
      alt=""
      width={560}
      widths={[360, 560, 900]}
      sizes="(max-width: 1023px) 0px, 30vw"
      loading="eager"
      class="pointer-events-none absolute left-[6%] top-10 -z-10 hidden w-[22vw] max-w-[360px] opacity-[0.12] lg:block"
    />

    <div class="relative mx-auto w-full max-w-7xl px-5 pb-12 sm:px-6 lg:py-20">
      <div class="lg:ml-auto lg:max-w-[40rem]">
        <div class="hidden lg:block" data-ref="2.2" data-ref-name="Búho y lugar">
          <Image
            src={buhoClaro}
            alt="Búho, sello de Fotografía Joel Godoy"
            width={96}
            widths={[96, 192]}
            sizes="96px"
            loading="eager"
            class="mb-6 h-auto w-20 opacity-95"
          />
          <p class="text-[0.7rem] font-semibold uppercase tracking-[0.35em] text-white/80">
            Fotografía de bodas · Los Mochis, Sinaloa
          </p>
        </div>
        <h1
          data-ref="2.3"
          data-ref-name="Título"
          class="sr-only mt-5 font-heading leading-[0.98] lg:not-sr-only lg:block lg:text-[5.2rem]"
        >
          Historias que se quedan <em class="text-[#d9b48c]">para siempre</em>.
        </h1>
      <p
        data-ref="2.4"
        data-ref-name="Texto"
        class="-mt-2 max-w-xl text-base leading-relaxed text-white/80 md:text-lg lg:mt-6"
      >
        Bodas en playa, salón y hacienda, XV años y momentos en familia. Fotografía natural, elegante y sin poses
        forzadas.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row" data-ref="2.5" data-ref-name="Botones">
        <a
          href="#catalogo"
          class="inline-flex items-center justify-center rounded-full bg-white px-8 py-3.5 font-semibold text-[#1c1915] transition hover:bg-[#efe7dc]"
          >Ver catálogo</a
        >
        <a
          href={waLink()}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-full border border-white/50 px-8 py-3.5 font-semibold text-white transition hover:bg-white/10"
        >
          <Icon name="tabler:brand-whatsapp" class="h-5 w-5" /> Cotizar por WhatsApp
        </a>
      </div>

      <dl data-ref="2.6" data-ref-name="Cifras" class="mt-10 grid max-w-2xl grid-cols-3 gap-6 border-t border-white/20 pt-6 text-white/90 lg:mt-14">
        <div>
          <dt class="text-[0.65rem] uppercase tracking-[0.2em] text-white/60">Seguidores</dt>
          <dd class="mt-1 font-heading text-3xl md:text-4xl">{NEGOCIO.seguidores}</dd>
        </div>
        <div>
          <dt class="text-[0.65rem] uppercase tracking-[0.2em] text-white/60">Recomiendan</dt>
          <dd class="mt-1 font-heading text-3xl md:text-4xl">{NEGOCIO.recomendacion}</dd>
        </div>
        <div>
          <dt class="text-[0.65rem] uppercase tracking-[0.2em] text-white/60">Opiniones</dt>
          <dd class="mt-1 font-heading text-3xl md:text-4xl">{NEGOCIO.opiniones}</dd>
        </div>
      </dl>
      </div>
    </div>
  </section>

  <!-- Estilo / presentación ***************** -->
  <section id="estilo" data-ref="3" data-ref-name="Estilo" class="scroll-mt-[7.5rem] lg:scroll-mt-20">
    <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 py-20 sm:px-6 md:py-28 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <div class="relative" data-ref="3.1" data-ref-name="Foto">
          <Image
            src={RETRATO.src}
            alt={RETRATO.alt}
            width={800}
            height={1000}
            widths={[400, 800]}
            sizes="(max-width: 1023px) 100vw, 40vw"
            class="aspect-[4/5] w-full rounded-sm object-cover"
          />
          <div
            data-ref="3.2"
            data-ref-name="Tarjeta de Joel"
            class="absolute -bottom-8 -right-2 flex max-w-[17rem] items-center gap-4 bg-page p-4 shadow-xl shadow-black/10 sm:-right-4 md:-right-8 md:p-5"
          >
            <Image
              src={joelRetrato}
              alt="Joel Godoy, fotógrafo"
              width={72}
              height={72}
              widths={[72, 144]}
              sizes="72px"
              class="h-16 w-16 flex-none rounded-full object-cover object-top grayscale md:h-[72px] md:w-[72px]"
            />
            <div>
              <p class="font-heading text-lg italic leading-snug text-heading">“La mejor foto es la que no se posó.”</p>
              <p class="mt-1 text-[0.65rem] font-semibold uppercase tracking-[0.2em] text-accent">Joel Godoy</p>
            </div>
          </div>
        </div>
      </div>
      <div class="lg:col-span-6 lg:col-start-7">
        <div data-ref="3.3" data-ref-name="Título">
          <p class="eyebrow">Nuestro estilo</p>
          <h2 class="mt-4 font-heading text-4xl leading-[1.05] text-heading md:text-[3.6rem]">
            Fotografía documental con <em class="text-accent">alma editorial</em>.
          </h2>
        </div>
        <div data-ref="3.4" data-ref-name="Texto" class="mt-7 space-y-5 text-[1.05rem] leading-relaxed text-muted">
          <p>
            Soy {NEGOCIO.fotografo}, fotógrafo profesional en Los Mochis. Me especializo en bodas y fotografía de
            eventos: observo, anticipo y guío lo justo para que tú solo te preocupes por disfrutar.
          </p>
          <p>
            Trabajo con luz natural, composición cuidada y una edición atemporal, para que tus fotos se vean igual de
            bien hoy que dentro de veinte años.
          </p>
        </div>
        <ul data-ref="3.5" data-ref-name="Cualidades" class="mt-9 grid gap-4 sm:grid-cols-3">
          {
            [
              { i: 'tabler:sun-high', t: 'Luz natural' },
              { i: 'tabler:heart-handshake', t: 'Trato cercano' },
              { i: 'tabler:photo-check', t: 'Edición atemporal' },
            ].map(({ i, t }) => (
              <li class="flex items-center gap-3 border-t border-black/10 pt-4 text-sm font-semibold text-heading dark:border-white/10">
                <Icon name={i} class="h-5 w-5 text-accent" />
                {t}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Catálogo ****************************** -->
  <section id="catalogo" data-ref="4" data-ref-name="Catálogo" class="scroll-mt-[7.5rem] lg:scroll-mt-20 bg-soft">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 md:py-28">
      <div data-ref="4.1" data-ref-name="Título" class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <div>
          <p class="eyebrow">Catálogo</p>
          <h2 class="mt-4 font-heading text-4xl leading-[1.05] text-heading md:text-[3.6rem]">
            Cada celebración, <em class="text-accent">su propia luz</em>.
          </h2>
        </div>
        <p class="max-w-sm text-muted">
          Elige el tipo de evento y conoce cómo lo trabajamos, qué incluye y una galería de ejemplos.
        </p>
      </div>

      <h3 class="mt-14 mb-5 flex items-center justify-between text-xs font-semibold uppercase tracking-[0.3em] text-muted">
        Bodas <span class="text-[0.65rem] tracking-[0.2em] md:hidden">Desliza →</span>
      </h3>
      <div class={CARRUSEL} data-ref="4.2" data-ref-name="Bodas">
        {bodas.map((c) => <div class={SLIDE}><CategoryCard categoria={c} size="tall" /></div>)}
      </div>

      <h3 class="mt-14 mb-5 flex items-center justify-between text-xs font-semibold uppercase tracking-[0.3em] text-muted">
        XV años y eventos <span class="text-[0.65rem] tracking-[0.2em] md:hidden">Desliza →</span>
      </h3>
      <div class={CARRUSEL} data-ref="4.3" data-ref-name="XV años y eventos">
        {eventos.map((c) => <div class={SLIDE}><CategoryCard categoria={c} size="tall" /></div>)}
      </div>
    </div>
  </section>

  <!-- Momentos (mosaico) ******************** -->
  <section aria-label="Momentos" data-ref="5" data-ref-name="Momentos" class="mx-auto max-w-7xl px-4 py-20 sm:px-6 md:py-28">
    <div class="mb-12 text-center" data-ref="5.1" data-ref-name="Título">
      <p class="eyebrow">Momentos</p>
      <h2 class="mt-4 font-heading text-4xl leading-[1.05] text-heading md:text-[3.2rem]">
        Lo que se siente, <em class="text-accent">se ve</em>.
      </h2>
    </div>
    <div class="columns-2 gap-4 md:columns-3 md:gap-5" data-ref="5.2" data-ref-name="Mosaico de fotos">
      {
        MOMENTOS.map((f) => (
          <Image
            src={f.src}
            alt={f.alt}
            width={800}
            widths={[400, 800]}
            sizes="(max-width: 767px) 50vw, 33vw"
            class="mb-4 w-full break-inside-avoid rounded-sm object-cover md:mb-5 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
          />
        ))
      }
    </div>
  </section>

  <!-- Proceso ******************************* -->
  <section
    id="proceso"
    data-ref="6"
    data-ref-name="Proceso"
    class="scroll-mt-[7.5rem] lg:scroll-mt-20 border-y border-black/10 dark:border-white/10"
  >
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 md:py-28">
      <div class="max-w-2xl" data-ref="6.1" data-ref-name="Título">
        <p class="eyebrow">Cómo trabajamos</p>
        <h2 class="mt-4 font-heading text-4xl leading-[1.05] text-heading md:text-[3.2rem]">
          De la primera llamada <em class="text-accent">a tu galería</em>.
        </h2>
      </div>
      <ol data-ref="6.2" data-ref-name="Pasos" class="mt-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
        {
          PROCESO.map((p) => (
            <li class="border-t border-heading/80 pt-6">
              <span class="font-heading text-5xl italic text-accent">{p.n}</span>
              <h3 class="mt-3 text-lg font-semibold text-heading">{p.t}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{p.d}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Opiniones ***************************** -->
  <section id="opiniones" data-ref="7" data-ref-name="Opiniones" class="scroll-mt-[7.5rem] lg:scroll-mt-20">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 md:py-28">
      <div data-ref="7.1" data-ref-name="Título" class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <div>
          <p class="eyebrow">Opiniones</p>
          <h2 class="mt-4 font-heading text-4xl leading-[1.05] text-heading md:text-[3.2rem]">
            Lo que dicen <em class="text-accent">nuestras parejas</em>.
          </h2>
        </div>
        <a
          href={NEGOCIO.facebook + '/reviews'}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm font-semibold text-heading hover:text-accent"
        >
          <Icon name="tabler:star-filled" class="h-5 w-5 text-accent" />
          {NEGOCIO.recomendacion} lo recomienda · {NEGOCIO.opiniones} opiniones en Facebook
          <Icon name="tabler:arrow-up-right" class="h-4 w-4" />
        </a>
      </div>
      <div class="mt-12">
        <ReviewsMarquee opiniones={OPINIONES} nombres={RECOMIENDAN} />
      </div>
    </div>
  </section>

  <!-- Preguntas frecuentes ****************** -->
  <div data-ref="8" data-ref-name="Preguntas frecuentes">
  <FAQs
    id="preguntas"
    tagline="Preguntas frecuentes"
    title="Antes de apartar tu fecha"
    schema
    classes={{ container: 'max-w-5xl' }}
    items={[
      {
        title: '¿Con cuánto tiempo debo apartar mi fecha?',
        description:
          'Para bodas recomendamos de 6 a 12 meses, sobre todo en temporada alta. Para XV años y otros eventos, de 2 a 4 meses. La fecha se aparta con un anticipo.',
      },
      {
        title: '¿Viajan fuera de Los Mochis?',
        description:
          'Sí. Cubrimos todo Sinaloa (Topolobampo, El Fuerte, Guasave, Culiacán, Mazatlán) y bodas destino. Los viáticos se cotizan según la distancia.',
      },
      {
        title: '¿En cuánto tiempo entregan las fotos?',
        description:
          'Recibes un adelanto de tus mejores fotos en pocos días y la galería completa editada en un plazo de 3 a 6 semanas, según el paquete.',
      },
      {
        title: '¿Cómo recibo mis fotos?',
        description:
          'En una galería privada en línea para descargar y compartir con tu familia. También ofrecemos álbumes impresos e impresiones de gran formato.',
      },
      {
        title: '¿Tienen video?',
        description:
          'Podemos coordinar cobertura de video y highlights para tu evento. Pregúntanos por los paquetes combinados de foto y video.',
      },
      {
        title: '¿Cuánto cuesta?',
        description:
          'Depende del tipo de evento, horas de cobertura y entregables. Escríbenos por WhatsApp con tu fecha y te enviamos los paquetes disponibles.',
      },
    ]}
  />
  </div>

  <!-- Contacto ****************************** -->
  <ContactSection />
</Layout>
