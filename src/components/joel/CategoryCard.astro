---
import { Icon } from 'astro-icon/components';
import Image from '~/components/common/Image.astro';
import { getPermalink } from '~/utils/permalinks';
import type { Categoria } from '~/data/catalogo';

export interface Props {
  categoria: Categoria;
  /** 'tall' para las tarjetas grandes de bodas, 'wide' para el resto. */
  size?: 'tall' | 'wide';
}

const { categoria, size = 'tall' } = Astro.props;
---

<a
  href={getPermalink(`/catalogo/${categoria.slug}`)}
  class:list={[
    'group relative block overflow-hidden rounded-sm bg-black',
    size === 'tall' ? 'aspect-[3/4]' : 'aspect-[4/3] lg:aspect-[5/4]',
    'intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade',
  ]}
>
  <Image
    src={categoria.portada.src}
    alt={categoria.portada.alt}
    width={size === 'tall' ? 720 : 800}
    height={size === 'tall' ? 960 : 600}
    widths={[400, 720, 960]}
    sizes="(max-width: 767px) 100vw, 33vw"
    layout="cover"
    class="absolute inset-0 h-full w-full object-cover opacity-90 transition duration-700 ease-out group-hover:scale-105 group-hover:opacity-100"
  />
  <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/10 to-transparent"></div>
  <div class="absolute inset-x-0 bottom-0 p-6 text-white md:p-7">
    <p class="text-[0.65rem] font-semibold uppercase tracking-[0.3em] text-white/75">{categoria.grupo}</p>
    <h3
      class:list={[
        'mt-2 font-heading leading-[1.05]',
        size === 'tall' ? 'text-3xl md:text-[2.1rem]' : 'text-[1.75rem] md:text-[1.9rem]',
      ]}
    >
      {categoria.titulo}
    </h3>
    <p class="mt-1 font-heading text-lg italic text-white/85">{categoria.frase}</p>
    <span
      class="mt-4 inline-flex items-center gap-1.5 border-b border-white/40 pb-0.5 text-xs font-semibold uppercase tracking-[0.2em] transition group-hover:border-white"
    >
      Ver galería <Icon name="tabler:arrow-right" class="h-4 w-4 transition group-hover:translate-x-1" />
    </span>
  </div>
</a>
