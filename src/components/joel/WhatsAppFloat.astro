---
// Botón flotante de WhatsApp. Aparece al bajar de la portada para no tapar
// sus botones (la portada ya tiene «Agenda hoy mismo»).
import { Icon } from 'astro-icon/components';
import { waLink } from '~/data/negocio';
---

<a
  href={waLink()}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Escríbenos por WhatsApp"
  data-ref="11"
  data-ref-name="Botón flotante de WhatsApp"
  data-wa-float
  class="fixed bottom-5 right-5 z-50 inline-flex h-14 w-14 translate-y-24 items-center justify-center rounded-full bg-[#25D366] text-white opacity-0 shadow-lg shadow-black/20 transition duration-300 hover:scale-105 focus:outline-none focus-visible:ring-4 focus-visible:ring-[#25D366]/40 data-[visible]:translate-y-0 data-[visible]:opacity-100"
>
  <Icon name="tabler:brand-whatsapp" class="h-7 w-7" />
</a>

<script>
  const setup = () => {
    const btn = document.querySelector<HTMLElement>('[data-wa-float]');
    if (!btn) return;
    const update = () => btn.toggleAttribute('data-visible', window.scrollY > window.innerHeight * 0.6);
    update();
    if (btn.dataset.ready) return;
    btn.dataset.ready = '1';
    window.addEventListener('scroll', update, { passive: true });
  };
  setup();
  document.addEventListener('astro:page-load', setup);
</script>
