---
import { Icon } from 'astro-icon/components';
import { waLink } from '~/data/negocio';
---

<a
  href={waLink()}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Escríbenos por WhatsApp"
  data-ref="11"
  data-ref-name="Botón flotante de WhatsApp"
  class="fixed bottom-5 right-5 z-50 inline-flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lg shadow-black/20 transition hover:scale-105 focus:outline-none focus-visible:ring-4 focus-visible:ring-[#25D366]/40"
>
  <Icon name="tabler:brand-whatsapp" class="h-7 w-7" />
</a>
